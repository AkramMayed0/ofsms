# Copy to .env and fill in real values. NEVER commit the real .env file.
NODE_ENV=production
PORT=4000
FORCE_HTTPS=true
FRONTEND_URL=https://your-frontend.vercel.app

# PostgreSQL (Supabase / Render)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Auth — use long random strings (e.g. `openssl rand -hex 48`), different for each
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_SPONSOR_SECRET=
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# File storage (S3-compatible). Leave S3_BUCKET_NAME empty in dev to store files locally.
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=ofsms-documents
S3_ENDPOINT=

# Push notifications (Firebase Cloud Messaging)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# or: FIREBASE_SERVICE_ACCOUNT_BASE64=
